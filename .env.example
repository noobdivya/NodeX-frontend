# Base URL of the NodeX email verifier.
NEXT_PUBLIC_API_URL=http://localhost:8080

# NodeX P2P nodes to join the network through (comma-separated multiaddrs).
# Run NodeX-node and copy the address it prints.
NEXT_PUBLIC_BOOTSTRAP_PEERS=/ip4/127.0.0.1/tcp/4002/ws/p2p/<node-peer-id>

# Optional: STUN servers so browsers on different networks can connect
# directly (comma-separated). Not needed on one machine or one network.
# NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302
